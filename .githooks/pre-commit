#!/usr/bin/env bash
# .githooks/pre-commit — Lucid pre-commit gate.
#
# A receipt first, then the checks, all blocking but the last, a badge refresh:
#
#   1. The registry's commit level.  ``tools.rules run --level commit --staged``
#      runs what ``tools/rules/registry`` claims here: H1 / H5 / H6 / H7 and dead
#      ``lucid.`` paths on the staged blobs, the H4 guard, the C++ layer rules
#      with H13, and the quality ratchet.  Steps 1a to 1f are not records yet.
#
#   2. Docstring coverage.  ``tools/check_docstring_coverage.py``
#      catches the five blind-spot categories that silently degrade the
#      docs site: Google-style ``Args:`` blocks the build used to drop,
#      filename-equals-symbol thin docstrings, stub one-liners on public
#      symbols, prose-only docstrings on multi-param funcs (no
#      ``Parameters`` block), and lazy-loaded names invisible to Griffe.
#      Hard-fail so a new public op can't ship with empty docs cards.
#
#   3. LOC badge refresh.  Runs ``cloc lucid/`` and rewrites the
#      shield badge in README.md so it always matches the committed
#      source.  Re-stages README.md.  Soft-fails (warning only) when
#      cloc isn't installed.
#
# What skips part of this, and what that leaves behind: .githooks/README.md.

set -uo pipefail

# ── Receipt ─────────────────────────────────────────────────────────────────
# Post-commit reads it, and a commit it cannot tie to a finished run here gets a
# ``Lucid-Bypass`` trailer.  The first line is git's pid: both hooks are children of
# one ``git commit``, so a receipt left by an attempt that later aborted (a bad
# message, say) does not pass for this one.  ``done`` is written after the last check,
# not on exit, so that an early ``exit 0`` above it shows too.
RECEIPT="$(git rev-parse --git-path lucid-hook-ran)"
echo "${PPID}" > "${RECEIPT}"

# A check whose script this tree lacks cannot judge: the commit goes on and says so.
have() {
    [[ -f "$1" ]] && return 0
    echo "missing:${1##*/tools/}" >> "${RECEIPT}"
    return 1
}

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ── Parallel-agent worktrees ────────────────────────────────────────────────
# A linked worktree (``.git`` is a file there) belongs to an agent working on
# its own branch — see CLAUDE.md "병렬 에이전트 워크스페이스".  The writers of
# shared generated files stand down there: the api-data rebuild and the LOC
# badge below, the CHANGELOG amend in post-commit.  Run on every branch they
# would make each one touch the same files and conflict at land;
# ``tools/agent_ws.py land`` folds CHANGELOG in under a lock, and the next
# main-checkout commit or the nightly workflow catches api-data and the badge
# up.  MAIN_ROOT is the main checkout, where the shared venv lives.
MAIN_ROOT="$(cd "$(git rev-parse --path-format=absolute --git-common-dir)/.." && pwd)"
if [[ -f "${REPO_ROOT}/.git" ]]; then
    LUCID_SKIP_API_DATA=1
    LUCID_SKIP_LOC_BADGE=1
fi

# ── Python ──────────────────────────────────────────────────────────────────
# Pinned to a virtualenv, never taken from PATH.  These gates import the
# project's own dependencies, and tools/rules is Python 3.14 only:
# ``/usr/bin/python3`` is 3.9, where it is a SyntaxError.  With none of them the
# rules cannot be judged, so the commit does not go on.
#
# A worktree normally has its own light .venv (agent_ws.py bootstrap) that
# resolves ``lucid`` to the worktree.  Without one, fall back to the main
# checkout's venv with this worktree first on PYTHONPATH — the main venv's
# editable install would otherwise check the main checkout's code instead.
PY="${REPO_ROOT}/.venv/bin/python3"
if [[ ! -x "${PY}" ]]; then
    PY="${MAIN_ROOT}/.venv/bin/python3"
    export PYTHONPATH="${REPO_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
fi
if ! "${PY}" -c 'import sys; sys.exit(sys.version_info < (3, 14))' 2>/dev/null; then
    echo "  ❌  Pre-commit blocked: no Python 3.14 at ${REPO_ROOT}/.venv/bin/python3 or in the main checkout." >&2
    exit 1
fi

# ── 0. Parallel-agent claim gate ────────────────────────────────────────────
# Hard-fail.  Refuses staged files that another in-flight worktree (or the
# main checkout's uncommitted work) has also changed — the one condition under
# which a later land could conflict.  Free when no linked worktree exists.
# The script is the main checkout's copy, so every worktree runs the latest.
CLAIMS_SCRIPT="${MAIN_ROOT}/tools/agent_ws.py"
if have "${CLAIMS_SCRIPT}"; then
    if ! "${PY}" "${CLAIMS_SCRIPT}" check-commit; then
        exit 1
    fi
fi

# ── 1. The registry's commit level ──────────────────────────────────────────
# Hard-fail, seconds, in parallel: whatever a record in ``tools/rules/registry``
# claims at level=commit, each only when a staged path matches its trigger.  It
# comes before every ``exit 0`` below, which a worktree always takes.
#
# ``source-rules-staged`` reads the blobs.  ``numpy-h4``, ``cpp-layers`` and the
# ratchet read the working copy.  The first two could read a copy of the index, but
# the ratchet diffs against HEAD and needs the real repository, and it covers all of
# lucid/, so copying would rescue no commit.  A path staged differently from its
# working copy stops the run with exit 2, naming the path, rather than judge one
# text and commit another.  ``git commit -- path`` is unaffected: there the two agree.
RULES_MAIN="tools/rules/__main__.py"
if [[ ! -f "${REPO_ROOT}/${RULES_MAIN}" && -f "${MAIN_ROOT}/${RULES_MAIN}" ]]; then
    echo "  ❌  Pre-commit blocked: this branch predates tools/rules, so nothing here can judge it.  Rebase onto main." >&2
    exit 1
fi
if have "${REPO_ROOT}/${RULES_MAIN}" && ! (cd "${REPO_ROOT}" && "${PY}" -m tools.rules run --level commit --staged >&2); then
    echo "  ❌  Pre-commit blocked by a rule (see above)." >&2
    exit 1
fi

# ── 1a. Annotation table is fresh ───────────────────────────────────────────
# Hard-fail, under a second.  ``lucid/_annotations.py`` lists every name a
# module imports under ``TYPE_CHECKING``; a commit that adds one without
# regenerating the table leaves ``inspect.signature`` raising ``NameError``
# for that module.  Only a pytest checked it, so it landed stale twice in a
# day (``_metal_views``, ``serialization._storage_plan``).  Only when a lucid/
# Python file is staged.  The fix is the generator, never a hand edit.
ANN_SCRIPT="${REPO_ROOT}/tools/gen_annotation_names.py"
if have "${ANN_SCRIPT}"; then
    if git diff --cached --name-only --diff-filter=ACMRD | grep -qE '^lucid/.*\.py$'; then
        if ! (cd "${REPO_ROOT}" && "${PY}" -m tools.gen_annotation_names --check >&2); then
            echo "  ❌  Pre-commit blocked: run python -m tools.gen_annotation_names and stage lucid/_annotations.py." >&2
            exit 1
        fi
    fi
fi

# ── 1c. Audit baselines agree with themselves ───────────────────────────────
# Hard-fail, milliseconds.  ``lucid/test/audit/{coverage,doctest,suite}.json``
# carry a header total next to the body it sums; the audit writes both, a
# hand edit changes one (LCD-358: a deleted ``answered`` line left ``cells``
# one high and a unit test red on main).  Judges the staged blobs, only when
# one of the three is staged.  No override: the fix is to regenerate.
# core.hooksPath is the main checkout's .githooks, so this hook is main's in
# every worktree; take main's checker too (stdlib only), the worktree's when
# main has none.
BASELINE_SCRIPT="${MAIN_ROOT}/tools/check_audit_baselines.py"
[[ -f "${BASELINE_SCRIPT}" ]] || BASELINE_SCRIPT="${REPO_ROOT}/tools/check_audit_baselines.py"
if have "${BASELINE_SCRIPT}"; then
    if git diff --cached --name-only --diff-filter=ACMR \
        | grep -qE '^lucid/test/audit/(coverage|doctest|suite)\.json$'; then
        if ! (cd "${REPO_ROOT}" && "${PY}" "${BASELINE_SCRIPT}" --staged --root "${REPO_ROOT}"); then
            echo "  ❌  Pre-commit blocked: an audit baseline disagrees with itself." >&2
            exit 1
        fi
    fi
fi

# ── 1d. Stubs agree with the source and the loaded engine ───────────────────
# Hard-fail, under a second.  ``tools/check_stubs.py`` regenerates the three
# stubs and diffs them, and compares the hand-written engine sub-namespace
# stubs (``_C_engine.nn`` / ``linalg`` / ``fft`` / ``einops`` / ``diffeq`` /
# ``quantized`` / ``coreml`` / ``utils``) with the bound submodules: names
# both ways and every function's parameter names (LCD-402 — ``linalg``
# declared a ``foo`` the engine never had and omitted ``matrix_power``).
# CI runs the same script through lucid/test/stubs; land runs it too.  Only
# when Python or engine source, a stub, or the generator is staged.
STUBS_SCRIPT="${REPO_ROOT}/tools/check_stubs.py"
if have "${STUBS_SCRIPT}"; then
    if git diff --cached --name-only --diff-filter=ACMRD \
        | grep -qE '^(lucid/.*\.(py|pyi|cpp|h|mm)|tools/(gen_pyi|check_stubs|stub_namespaces)\.py)$'; then
        if ! (cd "${REPO_ROOT}" && "${PY}" "${STUBS_SCRIPT}" >&2); then
            echo "  ❌  Pre-commit blocked: stubs disagree with the source or the engine (see above)." >&2
            exit 1
        fi
    fi
fi

# ── 1d+. The phantom backend matches IBackend.h ─────────────────────────────
# Hard-fail, under a second.  ``lucid/_C/backend/PhantomBackend.h`` is
# generated from IBackend.h and overrides every virtual, the defaulted ones
# included; one added there without a rerun of
# ``tools/gen_phantom_backend.py`` would be inherited and run real code on
# phantom storage (LCD-466).  CI runs the same ``--check`` in the phase
# gate's checks part.  Only when IBackend.h, the generated header or the
# generator is staged.
PHANTOM_SCRIPT="${REPO_ROOT}/tools/gen_phantom_backend.py"
if have "${PHANTOM_SCRIPT}"; then
    if git diff --cached --name-only --diff-filter=ACMRD \
        | grep -qE '^lucid/_C/backend/(IBackend|PhantomBackend)\.h$|^tools/gen_phantom_backend\.py$'; then
        if ! (cd "${REPO_ROOT}" && "${PY}" "${PHANTOM_SCRIPT}" --check >&2); then
            echo "  ❌  Pre-commit blocked: PhantomBackend.h is out of date with IBackend.h (see above)." >&2
            exit 1
        fi
    fi
fi

# ── 1e. Engine dtype dispatch refuses what it does not handle ───────────────
# Hard-fail, ~2 s.  ``tools/check_dtype_dispatch.py`` finds a dtype ``if``
# chain ending in a bare ``else`` and a hand-written ``F32 || F64`` float test
# (CHA-225: half walked in double lanes past an allocation).  It existed but
# ran nowhere (LCD-326); CI runs it in scripts/ci_full.sh.  Only when engine
# C++ or the checker itself is staged.
DTYPE_SCRIPT="${REPO_ROOT}/tools/check_dtype_dispatch.py"
if have "${DTYPE_SCRIPT}"; then
    if git diff --cached --name-only --diff-filter=ACMR \
        | grep -qE '^(lucid/_C/.*\.(cpp|cc|h|hpp|mm)|tools/check_dtype_dispatch\.py)$'; then
        if ! (cd "${REPO_ROOT}" && "${PY}" "${DTYPE_SCRIPT}" >&2); then
            echo "  ❌  Pre-commit blocked: a dtype dispatch without a refusal (see above)." >&2
            exit 1
        fi
    fi
fi

# ── 1f. Backend method family layout (LCD-264) ──────────────────────────────
# Hard-fail, <1 s.  ``tools/check_backend_layout.py`` enforces that CpuBackend.h
# and GpuBackend.h only carry inline bodies on the KEEP_INLINE allow-list (<=10
# lines) and that backend/{cpu,gpu}/methods/*.cpp are git-tracked and contain
# only out-of-line <Backend>:: member definitions.
LAYOUT_SCRIPT="${REPO_ROOT}/tools/check_backend_layout.py"
if have "${LAYOUT_SCRIPT}"; then
    if git diff --cached --name-only --diff-filter=ACMRD \
        | grep -qE '^(lucid/_C/backend/(cpu|gpu)/.*\.(cpp|h)|tools/(check_backend_layout|backend_split)\.py)$'; then
        if ! (cd "${REPO_ROOT}" && "${PY}" "${LAYOUT_SCRIPT}" --quiet >&2); then
            echo "  ❌  Pre-commit blocked: backend method family layout violation (see above)." >&2
            exit 1
        fi
    fi
fi

# ── 2. Docstring coverage gate ──────────────────────────────────────────────
# Hard-fail.  The validator surfaces six distinct blind-spot categories
# that all manifest as empty / sparse / misleading docs pages on the
# site.  Run after the H4 guard so violations are reported in the same
# commit attempt rather than across two retries.
#
# Only run when the commit actually touches Python files under lucid/ —
# README / vault-only commits don't need to pay the AST walk.
DOCSTRING_SCRIPT="${REPO_ROOT}/tools/check_docstring_coverage.py"
if [[ "${LUCID_SKIP_DOCSTRING:-0}" != "1" ]] && have "${DOCSTRING_SCRIPT}"; then
    if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^lucid/.*\.py$'; then
        if ! "${PY}" "${DOCSTRING_SCRIPT}"; then
            echo "" >&2
            echo "  ❌  Pre-commit blocked: thin / unstructured docstrings detected." >&2
            echo "      Re-run with --list to see every offender:" >&2
            echo "          python3 tools/check_docstring_coverage.py --list" >&2
            exit 1
        fi
    fi
fi

# ── 2b. Cross-reference resolver ────────────────────────────────────────────
# Blocking.  ``check_docstring_xrefs.py`` scans every Lucid docstring for
# sphinx-style ``:func:`` / ``:class:`` / ``:meth:`` references and flags
# targets that don't resolve to a known Lucid, ``tools`` or stdlib
# symbol.  Runs only when ``web/public/api-data/`` exists, since it needs
# the built JSON to resolve paths.
#
# It was soft-fail for as long as it had false positives — two, both
# correct references the resolver did not index: a ``tools.`` module and
# an engine class emitted under its C++ name.  The resolver learned both
# and every one of 8663 symbols resolves, so a failure here now means a
# reference that really does not, and a broken link in the docs is worth
# a commit being stopped over.
XREF_SCRIPT="${REPO_ROOT}/tools/check_docstring_xrefs.py"
if [[ "${LUCID_SKIP_XREFS:-0}" != "1" ]] && have "${XREF_SCRIPT}"; then
    if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^lucid/.*\.py$'; then
        if [[ -d "${REPO_ROOT}/web/public/api-data" ]]; then
            if ! "${PY}" "${XREF_SCRIPT}" --list >&2; then
                echo "" >&2
                echo "  ❌  Unresolved docstring cross-references (see above)." >&2
                exit 1
            fi
        fi
    fi
fi

# ── 2c. Docs API-data sync ──────────────────────────────────────────────────
# The docs site reads pre-built JSON from ``web/public/api-data/`` — that
# directory is checked in so the GitHub Pages workflow can skip Griffe
# entirely and deploy from source.  Whenever this commit touches
# ``lucid/**/*.{py,pyi}``, regenerate the JSON tree and re-stage it so
# the source-of-truth and the rendered API data ship together.
#
# Skip with ``LUCID_SKIP_API_DATA=1`` (per-commit override) when the
# regeneration cost is unwanted (e.g. partial commits, infra fix-ups).
# Measured 2026-07-26: ~4 min via the cached wrapper for a one-file change
# (the Griffe walk loads the whole tree no matter how few slugs are stale),
# ~13 min uncached.  That cost is why this is bypassed in practice, so the
# ``Docs api-data refresh`` workflow is the real backstop — it re-checks
# nightly and regenerates whatever was skipped here.

if [[ "${LUCID_SKIP_API_DATA:-0}" != "1" ]]; then
    STAGED_LUCID="$(git diff --cached --name-only --diff-filter=ACMR \
        | grep -E '^lucid/.*\.(py|pyi)$' || true)"
    BUILD_SCRIPT="${REPO_ROOT}/web/scripts/build-api-data-cached.py"
    if [[ -n "$STAGED_LUCID" && -f "$BUILD_SCRIPT" ]]; then
        echo "  [api-data] lucid/ source changed — rebuilding web/public/api-data/…"
        if (
            cd "$REPO_ROOT" && \
            PYTHONPATH="${REPO_ROOT}" "${PY}" web/scripts/build-api-data-cached.py \
                >/tmp/lucid-api-data.log 2>&1 && \
            # Mirror ``pnpm prebuild``: post-process so the committed JSON is the
            # FULL deployable artifact (cross-links / used-by / citations /
            # meta), not griffe-only.  Without this a lucid commit strips the
            # post-processing and the docs ``post-processor drift`` gate fails.
            "${PY}" web/scripts/build-cross-links.py >>/tmp/lucid-api-data.log 2>&1 && \
            "${PY}" web/scripts/build-usedby.py      >>/tmp/lucid-api-data.log 2>&1 && \
            "${PY}" web/scripts/link-citations.py    >>/tmp/lucid-api-data.log 2>&1 && \
            "${PY}" web/scripts/build-bibtex.py      >>/tmp/lucid-api-data.log 2>&1 && \
            "${PY}" web/scripts/build-meta.py        >>/tmp/lucid-api-data.log 2>&1 && \
            # Re-baseline the content-hash drift cache so ``--check`` (the
            # ``source drift`` gate) stays in sync with the regenerated tree.
            "${PY}" web/scripts/build-api-data-cached.py --write-cache \
                >>/tmp/lucid-api-data.log 2>&1
        ); then
            git add "${REPO_ROOT}/web/public/api-data"
            echo "  [api-data] ✓ re-staged $(git diff --cached --name-only \
                -- web/public/api-data | wc -l | tr -d ' ') JSON file(s)"
        else
            echo "  ❌  api-data build failed — see /tmp/lucid-api-data.log" >&2
            exit 1
        fi
    fi
fi

# Every check above has passed; what follows only refreshes a badge.
echo done >> "${RECEIPT}"

# ── 3. LOC badge refresh ────────────────────────────────────────────────────
if [[ "${LUCID_SKIP_LOC_BADGE:-0}" == "1" ]]; then
    exit 0
fi

README="${REPO_ROOT}/README.md"

if ! command -v cloc &>/dev/null; then
    echo "  ⚠️  cloc not found — skipping LOC badge update (brew install cloc)" >&2
    exit 0
fi

LOC="$(cloc "${REPO_ROOT}/lucid" --quiet 2>/dev/null | awk '/^SUM:/{print $NF}')"

if [[ -z "$LOC" || "$LOC" == "0" ]]; then
    echo "  ⚠️  cloc returned no result — skipping LOC badge update" >&2
    exit 0
fi

NEW_BADGE="![Lines of Code](https://img.shields.io/badge/Lines%20of%20Code-${LOC}-purple)"

sed -i '' \
    "s|!\[Lines of Code\](https://img\.shields\.io/badge/Lines%20of%20Code-[^)]*)|${NEW_BADGE}|g" \
    "${README}"

git add "${README}"
