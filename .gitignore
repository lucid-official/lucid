# Pretrained-weights conversion staging: a one-off conversion script's per-tag
# output (model.safetensors + config.json + README.md) before upload to the
# lucid-dl HF Hub org.  Never committed; prefer a directory outside the repo.
_converted/

# CLAUDE & CODEX
CLAUDE.md
AGENTS.md
.worktreeinclude

# workspace sync harness (local tooling, not part of the project)
.sync/

# The audit's live transcript.  ``lucid-audit`` writes it as it runs so a
# run can be read while it is still going, and shared afterwards; it is a
# record of one machine's run, never a source artefact.
/lucid/test/audit.log

# Pinned MLX runtime copied next to the engine by a wheel build (setup.py);
# never committed: ~210 MB, staged from [tool.lucid.mlx] by tools/fetch_mlx.py.
lucid/_C/*.dylib
lucid/_C/*.metallib
