def logsumexp(input: Tensor, dim: _int | Sequence[_int] | None = ..., keepdim: _bool = ...) -> Tensor:
    r"""    Compute the numerically stable log-sum-exp along ``dim``.
    
    Combines :func:`exp`, :func:`sum` and :func:`log` in a single fused
    operation, subtracting the per-slice maximum before exponentiation to
    avoid overflow.  This is the canonical normaliser of categorical
    log-probabilities and the smooth approximation of :func:`max`.
    
    Parameters
    ----------
    input : Tensor
        Input tensor (real-valued).
    dim : int or sequence of int, optional
        Dimension(s) over which to reduce.
    keepdim : bool, default False
        Keep reduced dims with size 1 if ``True``.
    
    Returns
    -------
    Tensor
        Reduced tensor.
    
    Notes
    -----
    The stable formulation is
    
    .. math::
    
        \mathrm{LSE}(x) \;=\; m + \log\!\sum_i e^{x_i - m},
        \qquad m = \max_i x_i ,
    
    which avoids ``inf`` even when ``x`` has large positive components.
    LSE is convex, satisfies :math:`\max(x) \le \mathrm{LSE}(x) \le
    \max(x) + \log n`, and its gradient is the softmax.
    
    Examples
    --------
    >>> import lucid
    >>> x = lucid.tensor([1000.0, 1000.0, 1000.0])
    >>> lucid.logsumexp(x, dim=0)
    Tensor(1001.0986)
    """
    ...
def mm(input: Tensor, mat2: Tensor) -> Tensor:
    r"""    Strict 2-D matrix multiplication.
    
    Computes the product of two 2-D tensors of shapes ``(n, k)`` and ``(k, m)``. No
    broadcasting is performed; both operands must be exactly 2-D. For broadcasting
    or batched semantics use :func:`matmul` / :func:`bmm`.
    
    Parameters
    ----------
    input : Tensor
        Left matrix of shape ``(n, k)``.
    mat2 : Tensor or scalar
        Right matrix of shape ``(k, m)``. The inner dimension must match
        ``input``.
    
    Returns
    -------
    Tensor
        Matrix product of shape ``(n, m)``.
    
    Notes
    -----
    Mathematical definition:
    
    .. math::
    
        \mathbf{C}_{ij} = \sum_{r=1}^{k} \mathbf{A}_{ir}\,\mathbf{B}_{rj}
    
    Autograd mirrors :func:`matmul` but without any batch handling. Use this
    function when the rank assumption can be guaranteed for clearer error messages
    and slightly leaner dispatch.
    
    Examples
    --------
    >>> import lucid
    >>> a = lucid.tensor([[1.0, 2.0]])
    >>> b = lucid.tensor([[3.0], [4.0]])
    >>> lucid.mm(a, b)
    Tensor([[11.]])
    """
    ...
