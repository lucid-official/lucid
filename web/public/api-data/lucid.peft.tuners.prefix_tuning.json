      "summary": "The prefix of prefix tuning: key and value vectors for every layer, one row per virtual token.",
      "extended": "A row holds `2 * num_layers * token_dim` numbers — the key and the value\nof each layer.  With `prefix_projection` (and not `inference_mode`) the\nrows come from a `token_dim`-wide embedding through a two-layer MLP;\notherwise `embedding` holds them directly.",
      "parameters": [
        {
          "name": "config",
          "annotation": "PrefixTuningConfig",
          "description": "Sizes (`num_virtual_tokens`, `num_layers`, `token_dim`,\n`encoder_hidden_size` set) and the projection.",
          "default": null
        }
      ],
      "returns": null,
      "raises": [],
      "examples": [
        ">>> import lucid\n>>> from lucid.peft import PrefixTuningConfig\n>>> from lucid.peft.tuners.prefix_tuning import PrefixEncoder\n>>> config = PrefixTuningConfig(num_virtual_tokens=3, token_dim=8, num_layers=2,\n...                             encoder_hidden_size=8)\n>>> PrefixEncoder(config)(lucid.arange(3).long().reshape(1, 3)).shape\n(1, 3, 32)"
      ],
      "notes": [],
      "attributes": [
        {
          "name": "embedding",
          "annotation": "nn.Embedding",
          "description": "The rows (or the projection's input)."
        },
        {
          "name": "transform",
          "annotation": "nn.Module",
          "description": "The projection MLP, or `nn.Identity`."
        }
