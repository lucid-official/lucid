    {
      "name": "PrefixTuningConfig",
      "path": "lucid.peft.tuners.prefix_tuning._config.PrefixTuningConfig",
      "kind": "class",
      "class_kind": "dataclass",
      "bases": [
        "PromptLearningConfig"
      ],
      "labels": [],
      "signature": "PrefixTuningConfig(task_type: TaskType | str | None = None, peft_type: PeftType | str | None = None, auto_mapping: dict[str, str] | None = None, peft_version: str | None = None, base_model_name_or_path: str | None = None, revision: str | None = None, inference_mode: bool = False, num_virtual_tokens: int | None = None, token_dim: int | None = None, num_transformer_submodules: int | None = None, num_attention_heads: int | None = None, num_layers: int | None = None, modules_to_save: list[str] | None = None, init_weights: str | None = None, encoder_hidden_size: int | None = None, prefix_projection: bool = False)",
      "source": "https://github.com/lucid-official/lucid/blob/87d0276/lucid/peft/tuners/prefix_tuning/_config.py#L15",
      "subcategory": "config",
      "methods": [],
      "summary": "How `lucid.peft.get_peft_model` adapts a model with prefix tuning.",
      "extended": "Prefix tuning (Li and Liang, 2021, [arXiv:2101.00190](https://arxiv.org/abs/2101.00190)) learns\n`num_virtual_tokens` key and value vectors for **every** attention layer\nand puts them in front of that layer's own, so the whole network can attend\nto them: `num_virtual_tokens * 2 * num_layers * token_dim` numbers.  With\n`prefix_projection` the vectors are produced from a smaller embedding by a\ntwo-layer MLP while training, which the paper found steadier; the file\nstill stores the finished vectors.  An encoder-decoder model gets the prefix\non the decoder's self-attention.\n\nField names, their order, defaults and `adapter_config.json` are the reference adapter\nlibrary's.",
      "parameters": [
        {
          "name": "task_type",
          "annotation": "TaskType | str | None",
          "description": "As in `lucid.peft.PeftConfig`.",
          "default": "None"
        },
        {
          "name": "peft_type",
          "annotation": "TaskType | str | None",
          "description": "As in `lucid.peft.PeftConfig`.",
          "default": "None"
        },
        {
          "name": "auto_mapping",
          "annotation": "TaskType | str | None",
          "description": "As in `lucid.peft.PeftConfig`.",
          "default": "None"
        },
        {
          "name": "peft_version",
          "annotation": "TaskType | str | None",
          "description": "As in `lucid.peft.PeftConfig`.",
          "default": "None"
        },
        {
          "name": "base_model_name_or_path",
          "annotation": "TaskType | str | None",
          "description": "As in `lucid.peft.PeftConfig`.",
          "default": "None"
        },
        {
          "name": "revision",
          "annotation": "TaskType | str | None",
          "description": "As in `lucid.peft.PeftConfig`.",
          "default": "None"
        },
        {
          "name": "inference_mode",
          "annotation": "TaskType | str | None",
          "description": "As in `lucid.peft.PeftConfig`.",
          "default": "None"
        },
        {
          "name": "num_virtual_tokens",
          "annotation": "int | None",
          "description": "As in `lucid.peft.PromptLearningConfig`.",
          "default": "None"
        },
        {
          "name": "token_dim",
          "annotation": "int | None",
          "description": "As in `lucid.peft.PromptLearningConfig`.",
          "default": "None"
        },
        {
          "name": "num_transformer_submodules",
          "annotation": "int | None",
          "description": "As in `lucid.peft.PromptLearningConfig`.",
          "default": "None"
        },
        {
          "name": "num_attention_heads",
          "annotation": "int | None",
          "description": "As in `lucid.peft.PromptLearningConfig`.",
          "default": "None"
        },
        {
          "name": "num_layers",
          "annotation": "int | None",
          "description": "As in `lucid.peft.PromptLearningConfig`.",
          "default": "None"
        },
        {
          "name": "modules_to_save",
          "annotation": "int | None",
          "description": "As in `lucid.peft.PromptLearningConfig`.",
          "default": "None"
        },
        {
          "name": "init_weights",
          "annotation": "zero",
          "description": "`\"zero\"` starts the prefix at zeros (the output layer of the\nprojection, when there is one) so the keys and values it adds are null.",
          "default": "\"zero\""
        },
        {
          "name": "encoder_hidden_size",
          "annotation": "int",
          "description": "Width of the projection MLP's hidden layer; `token_dim` when omitted.",
          "default": "None"
        },
        {
          "name": "prefix_projection",
          "annotation": "bool",
          "description": "Produce the prefix through the projection MLP while training.",
          "default": "False"
        }
      ],
      "returns": null,
      "raises": [
        {
          "annotation": "TypeError",
          "description": "A field holds a value of the wrong type."
        }
      ],
      "examples": [
        ">>> from lucid.peft import PrefixTuningConfig\n>>> config = PrefixTuningConfig(num_virtual_tokens=4, prefix_projection=True)\n>>> config.peft_type, config.prefix_projection\n(<PeftType.PREFIX_TUNING: 'PREFIX_TUNING'>, True)"
      ],
      "notes": [],
      "attributes": [],
      "warns": [],
      "see_also": []
    },
